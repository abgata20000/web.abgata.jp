---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="サービス"
  description="WEB制作・システム開発・モバイルアプリ開発・サイト運営管理など、エイビーのサービスをご紹介します。"
  currentPage="service"
>
  <!-- ページヘッダー -->
  <section class="page-header">
    <div class="container">
      <h1 class="section-title">Service</h1>
      <p class="page-lead">サービス</p>
    </div>
  </section>

  <!-- サービス概要 -->
  <section class="section">
    <div class="container">
      <div class="lead-block fade-in">
        <p class="lead-catch">「ホームページ制作」ではなく、<br><strong>「動くサービスの構築」</strong>が専門です。</p>
        <p class="lead-body">
          見た目だけのサイトではなく、ログイン・課金・予約・管理機能などを含む "動くサービス" の構築を行っています。
          事業の仕組みそのものをシステムとして実装し、ビジネスの成長を技術で支えます。
        </p>
      </div>
    </div>
  </section>

  <!-- サービス一覧 -->
  <section class="section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">できること</h2>
        <p class="section-subtitle">構築実績のあるシステム・機能</p>
      </div>
      <ul class="grid-cards service-grid" role="list">

        <!-- 会員制サービス -->
        <li class="card service-card fade-in">
          <div class="service-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="4"/>
              <path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
              <path d="M16 3.5c1.5.5 3 2 3 4.5"/>
              <path d="M8 3.5C6.5 4 5 5.5 5 8"/>
            </svg>
          </div>
          <h3 class="service-name">会員制サービス構築</h3>
          <p class="service-desc">ログイン・マイページ機能を備えた会員向けサービスを構築します。</p>
          <ul class="service-examples">
            <li>オンラインサロンのようなサイト</li>
            <li>Udemy的な講座配信サイト</li>
          </ul>
        </li>

        <!-- 予約システム -->
        <li class="card service-card fade-in">
          <div class="service-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2"/>
              <path d="M16 2v4M8 2v4M3 10h18"/>
              <path d="M8 14h.01M12 14h.01M16 14h.01M8 18h.01M12 18h.01"/>
            </svg>
          </div>
          <h3 class="service-name">予約システム</h3>
          <p class="service-desc">時間枠管理・キャンセル対応など本格的な予約機能を実装します。</p>
          <ul class="service-examples">
            <li>スクール・施設の時間枠予約</li>
            <li>美容室・ジムの予約システム</li>
          </ul>
        </li>

        <!-- 月額課金 -->
        <li class="card service-card fade-in">
          <div class="service-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
            </svg>
          </div>
          <h3 class="service-name">月額課金（サブスク）モデル</h3>
          <p class="service-desc">Stripe 等の決済サービスと連携した継続課金の仕組みを構築します。</p>
          <ul class="service-examples">
            <li>オンラインスクールの月額課金</li>
            <li>会員制コミュニティの継続課金</li>
          </ul>
        </li>

        <!-- オンライン決済 -->
        <li class="card service-card fade-in">
          <div class="service-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="4" width="22" height="16" rx="2"/>
              <path d="M1 10h22"/>
            </svg>
          </div>
          <h3 class="service-name">オンライン決済付きサービス</h3>
          <p class="service-desc">チケット販売・イベント参加費の事前決済など、決済機能を組み込みます。</p>
          <ul class="service-examples">
            <li>チケット販売サイト</li>
            <li>簡易 EC サイト</li>
          </ul>
        </li>

        <!-- 管理画面 -->
        <li class="card service-card fade-in">
          <div class="service-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" rx="1"/>
              <rect x="14" y="3" width="7" height="7" rx="1"/>
              <rect x="14" y="14" width="7" height="7" rx="1"/>
              <rect x="3" y="14" width="7" height="7" rx="1"/>
            </svg>
          </div>
          <h3 class="service-name">管理画面つき業務システム</h3>
          <p class="service-desc">会員・売上・履歴など、サービス運営に必要な管理機能を開発します。</p>
          <ul class="service-examples">
            <li>会員管理システム</li>
            <li>売上管理ダッシュボード</li>
          </ul>
        </li>

        <!-- マッチングサイト -->
        <li class="card service-card fade-in">
          <div class="service-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 20h5v-2a3 3 0 0 0-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 0 1 5.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 0 1 9.288 0"/>
            </svg>
          </div>
          <h3 class="service-name">マッチングサイト</h3>
          <p class="service-desc">スキルや求人など、ユーザー同士をつなぐマッチング機能を実装します。</p>
          <ul class="service-examples">
            <li>スキルマッチングサービス</li>
            <li>求人・人材マッチング</li>
          </ul>
        </li>

        <!-- チャット -->
        <li class="card service-card fade-in">
          <div class="service-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
          </div>
          <h3 class="service-name">チャット機能つきサービス</h3>
          <p class="service-desc">リアルタイムのメッセージ機能をサービスに組み込みます。</p>
          <ul class="service-examples">
            <li>サービス内メッセージ機能</li>
            <li>サポートチャットシステム</li>
          </ul>
        </li>

        <!-- リアルタイム通知 -->
        <li class="card service-card fade-in">
          <div class="service-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
              <path d="M13.73 21a2 2 0 0 1-3.46 0"/>
            </svg>
          </div>
          <h3 class="service-name">リアルタイム通知システム</h3>
          <p class="service-desc">予約・メッセージ・在庫変動などを即時に通知する仕組みを構築します。</p>
          <ul class="service-examples">
            <li>予約が入った瞬間に通知</li>
            <li>ステータス・在庫の即時更新</li>
          </ul>
        </li>

        <!-- 外部連携 -->
        <li class="card service-card fade-in">
          <div class="service-icon" aria-hidden="true">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3"/>
              <circle cx="6" cy="12" r="3"/>
              <circle cx="18" cy="19" r="3"/>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
            </svg>
          </div>
          <h3 class="service-name">外部サービス連携</h3>
          <p class="service-desc">LINE・Google ログインや Stripe 決済など、外部 API との接続を行います。</p>
          <ul class="service-examples">
            <li>LINE / Google ログイン</li>
            <li>Stripe / PAY.JP 決済連携</li>
          </ul>
        </li>

      </ul>
    </div>
  </section>

  <!-- 料金 -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">料金について</h2>
        <p class="section-subtitle">作業日数ベースのシンプルな価格体系</p>
      </div>
      <div class="pricing-wrap fade-in">
        <div class="pricing-base">
          <p class="pricing-label">基本単価</p>
          <p class="pricing-amount"><span class="pricing-num">5</span>万円<span class="pricing-unit"> / 日</span></p>
          <p class="pricing-note">内容に応じて作業日数ベースでお見積りします</p>
        </div>
        <div class="pricing-table-wrap">
          <table class="pricing-table">
            <thead>
              <tr>
                <th scope="col">規模感</th>
                <th scope="col">作業日数目安</th>
                <th scope="col">費用目安</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>小規模機能追加</td>
                <td>3〜5日</td>
                <td class="price-cell">15〜25万円</td>
              </tr>
              <tr>
                <td>予約・会員機能を含むサービス構築</td>
                <td>10日〜</td>
                <td class="price-cell">50万円〜</td>
              </tr>
              <tr>
                <td>中規模以上のサービス開発</td>
                <td>20日〜</td>
                <td class="price-cell">100万円〜</td>
              </tr>
            </tbody>
          </table>
          <p class="pricing-caveat">※ 価格重視の案件はお受けしていません。</p>
        </div>
      </div>
    </div>
  </section>

  <!-- お取引スタンス -->
  <section class="section-alt">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">お取引スタンス</h2>
        <p class="section-subtitle">長期パートナーシップを前提に</p>
      </div>
      <div class="stance-wrap">
        <div class="stance-block fade-in">
          <div class="stance-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
          </div>
          <div>
            <h3 class="stance-title">長期的に一緒に育てる前提で</h3>
            <p class="stance-body">
              システム開発には基本的に「完成」はありません。改善や機能追加を繰り返しながら育てていくものです。
              そのため、単発の軽微修正のみのご依頼はお受けしていません。
              長期的に一緒にサービスを育てていく前提でのお取引になります。
            </p>
          </div>
        </div>
        <div class="stance-block fade-in">
          <div class="stance-icon" aria-hidden="true">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
              <polyline points="17 6 23 6 23 12"/>
            </svg>
          </div>
          <div>
            <h3 class="stance-title">共同開発・レベニューシェアにも対応</h3>
            <p class="stance-body">
              受託開発だけではなく、新サービスの共同開発の場合はレベニューシェアなど柔軟に対応します。
              「こんなサービスがあったらいいのに」というアイデアがあれば、ぜひ一緒に面白いものを作りましょう。
            </p>
          </div>
        </div>
      </div>
      <div class="stance-cta">
        <p class="stance-cta-text">本気で事業を作りたい方、まずはお気軽にご相談ください。</p>
        <a href="https://page.line.me/488adkec" class="btn-primary" target="_blank" rel="noopener noreferrer">LINEで相談する</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ページヘッダー */
  .page-header {
    padding-block: var(--space-16);
    text-align: center;
  }

  .page-lead {
    color: var(--color-text-secondary);
    font-size: var(--text-lg);
  }

  /* リード */
  .lead-block {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
  }

  .lead-catch {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: var(--leading-normal);
    margin-bottom: var(--space-6);
    color: var(--color-text-primary);
  }

  .lead-catch strong {
    color: var(--color-primary);
  }

  .lead-body {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  @media (min-width: 768px) {
    .lead-catch {
      font-size: var(--text-2xl);
    }
  }

  /* サービスグリッド */
  .service-grid {
    padding: 0;
  }

  .service-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .service-icon {
    color: var(--color-primary);
    width: 48px;
    height: 48px;
  }

  .service-icon svg {
    width: 48px;
    height: 48px;
  }

  .service-name {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: var(--space-1);
  }

  .service-desc {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
    flex: 1;
  }

  .service-examples {
    margin-top: var(--space-2);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .service-examples li {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    padding-left: var(--space-4);
    position: relative;
  }

  .service-examples li::before {
    content: '例：';
    position: absolute;
    left: 0;
    color: var(--color-primary);
    font-weight: 700;
    font-size: var(--text-xs);
  }

  .service-examples li:not(:first-child)::before {
    content: '';
  }

  /* 料金 */
  .pricing-wrap {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
    align-items: start;
  }

  @media (min-width: 768px) {
    .pricing-wrap {
      grid-template-columns: 280px 1fr;
      gap: var(--space-12);
    }
  }

  .pricing-base {
    background: var(--color-primary-bg);
    border: 2px solid var(--color-primary);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-align: center;
  }

  .pricing-label {
    font-family: var(--font-heading);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--color-primary-dark);
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-3);
  }

  .pricing-amount {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .pricing-num {
    font-size: var(--text-5xl);
    color: var(--color-primary);
  }

  .pricing-unit {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
  }

  .pricing-note {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .pricing-table-wrap {
    overflow-x: auto;
  }

  .pricing-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  .pricing-table th {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    letter-spacing: var(--tracking-wide);
    text-align: left;
    padding: var(--space-3) var(--space-4);
    border-bottom: 2px solid var(--color-border);
    white-space: nowrap;
  }

  .pricing-table td {
    padding: var(--space-4);
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-primary);
    vertical-align: middle;
  }

  .pricing-table tr:hover td {
    background: var(--color-gray-50);
  }

  .price-cell {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-primary);
    white-space: nowrap;
  }

  .pricing-caveat {
    margin-top: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  /* お取引スタンス */
  .stance-wrap {
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
    margin-bottom: var(--space-12);
  }

  @media (min-width: 768px) {
    .stance-wrap {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .stance-block {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    padding: var(--space-6) var(--space-8);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .stance-icon {
    color: var(--color-primary);
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    margin-top: var(--space-1);
  }

  .stance-icon svg {
    width: 32px;
    height: 32px;
  }

  .stance-title {
    font-family: var(--font-heading);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-3);
  }

  .stance-body {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
  }

  .stance-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
  }

  .stance-cta-text {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--color-text-primary);
  }
</style>

<script>
  // fade-in アニメーション (prefers-reduced-motion 考慮はCSSで対応済み)
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.fade-in').forEach((el) => observer.observe(el));
</script>
