---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="お問い合わせ"
  description="エイビーへのお問い合わせはLINE公式アカウントからお願いいたします。"
  currentPage="contact"
>
  <section class="page-header">
    <div class="container">
      <h1 class="section-title">Contact</h1>
      <p class="page-lead">お問い合わせ</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="contact-content">
        <div class="line-block">
          <div class="line-icon" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="#06c755">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
            </svg>
          </div>
          <h2 class="line-heading">LINE公式アカウントからお問い合わせください</h2>
          <p class="line-desc">
            お問い合わせは LINE 公式アカウントで受け付けています。<br />
            「こんなことできる？」という段階からお気軽にメッセージください。
          </p>
          <a href="https://page.line.me/488adkec" class="btn-line" target="_blank" rel="noopener noreferrer">
            <svg class="btn-line-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63h2.386c.349 0 .63.285.63.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.627-.63.349 0 .631.285.631.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/>
            </svg>
            LINE で友だち追加する
          </a>
        </div>

        <div class="response-note">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <path d="M12 16v-4"/>
            <path d="M12 8h.01"/>
          </svg>
          <p>通常2営業日以内にご返信いたします。</p>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact-content {
    max-width: 600px;
    margin-inline: auto;
  }

  .line-block {
    text-align: center;
    padding: var(--space-10) var(--space-6);
    background: var(--color-bg-card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
  }

  .line-icon {
    margin-bottom: var(--space-3);
  }

  .line-heading {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--space-4);
  }

  .line-desc {
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
  }

  .btn-line {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: #06c755;
    color: var(--color-white);
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--text-base);
    padding: var(--space-3) var(--space-8);
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: opacity var(--transition-base);
    box-shadow: var(--shadow-sm);
  }

  .btn-line:hover {
    opacity: 0.85;
    color: var(--color-white);
  }

  .btn-line-icon {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .response-note {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding: var(--space-4);
    background: var(--color-primary-bg);
    border-radius: var(--radius-md);
    color: var(--color-primary-dark);
    font-size: var(--text-sm);
  }

  .response-note svg {
    flex-shrink: 0;
    margin-top: 2px;
  }
</style>
